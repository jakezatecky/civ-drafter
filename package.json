{
  "name": "civ-drafter",
  "version": "1.12.0",
  "description": "A modern, mobile-friendly drafting tool for Sid Meier's Civilization VI.",
  "type": "module",
  "imports": {
    "#js/*": "./src/js/*",
    "#json/*": "./src/json/*"
  },
  "scripts": {
    "build": "webpack",
    "build-prod": "webpack --config-node-env=production && node ./scripts/generateSitemap.js",
    "dev-server": "webpack serve",
    "format:style": "prettier --write src/scss",
    "lint": "npm run lint:script && npm run lint:style && npm run lint:types",
    "lint:script": "eslint src/js test scripts *.js",
    "lint:style": "stylelint \"src/scss/**/*.scss\"",
    "lint:types": "tsc && tsc -p test",
    "test": "npm run lint && npm run test:script && npm run test:style && npm run test:style-format",
    "test:script": "webpack --config=webpack.config.test.js && mocha test-compiled/index.js",
    "test:style": "mocha test/styles.js",
    "test:style-format": "prettier --check src/scss"
  },
  "author": "Jake Zatecky",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": "^9.0.1",
    "bootstrap": "^6.0.0-alpha.1",
    "classnames": "^2.3.2",
    "lodash": "^4.17.21",
    "marked": "^18.0.3",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.6",
    "react-checkbox-tree": "^2.0.1",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/chai": "^5.2.3",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinon": "^22.0.2",
    "babel-loader": "^10.0.0",
    "chai": "^6.0.1",
    "css-loader": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-config-takiyon-react": "^8.0.1",
    "fast-xml-builder": "^1.3.1",
    "global-jsdom": "^30.0.0",
    "globals": "^17.6.0",
    "html-bundler-webpack-plugin": "^4.21.1",
    "jsdom": "^30.1.1",
    "mocha": "^12.0.2",
    "prettier": "^3.0.0",
    "sass": "^1.57.1",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.4",
    "sinon": "^22.0.0",
    "stylelint": "^17.1.1",
    "stylelint-config-takiyon": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "webpack": "^5.3.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^6.0.0",
    "workbox-webpack-plugin": "^7.0.0"
  }
}
